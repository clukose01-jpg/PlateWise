# Copy this file to .env.local and paste your key from https://platform.claude.com
ANTHROPIC_API_KEY=

# Daily reminders (optional). Make a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Any long random text. Vercel's scheduler sends it so only it can trigger reminders.
CRON_SECRET=
