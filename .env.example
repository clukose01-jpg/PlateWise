# Copy this file to .env.local and paste your key from https://platform.claude.com
ANTHROPIC_API_KEY=

# Daily reminders (optional). Make a key pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Any long random text. Vercel's scheduler sends it so only it can trigger reminders.
CRON_SECRET=

# Logging in (optional). Codes are emailed from the app's Gmail account using an app password;
# without these they print in the terminal.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Any long random text. It signs who's logged in; changing it logs everyone out.
SESSION_SECRET=
